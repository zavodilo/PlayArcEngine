    "createdFrom": "arcengine-sample-2d",
    "camera": {
        "mode": "isometric",
        "follow": "character",
        "azimuthDeg": -90,
        "elevationDeg": 60,
        "orthoHeightPx": 420,
        "orbit": false
    },
    "lighting": { "preset": "stylized", "shadows": 1, "toon": 1, "ink": 1, "outline": 1 },
    "materials": { "shading": "toon" },
    "environment": { "ground": "plane+sprites", "flatten": 0, "tilePx": 64 },
    "animation": { "style": "hybrid" },
    "ui": { "space": "screen" },
    "audio": { "spatial": true },
    "visualMappings": "presentation/mappings/arcengine-sample-2.5d.json"
}
