{
    "id": "arcengine-sample-2.5d",
    "name": "ArcEngine Sample — Hybrid 2.5D",
    "profile": "2.5d",
    "enabled": true,
    "description": "2D characters in a 3D world: the hero keeps its sprite as a billboard, the mill and the ground are real 3D, the camera is a tilted orthographic one.",
