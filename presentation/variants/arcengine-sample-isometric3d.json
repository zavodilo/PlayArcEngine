        "orthoHeightPx": 480,
        "orbit": false
    },
    "lighting": { "preset": "isometric", "shadows": 1, "toon": 1, "ink": 2, "outline": 2 },
    "materials": { "shading": "toon" },
    "environment": { "ground": "3d-tiles", "flatten": 0, "tilePx": 64 },
    "animation": { "style": "skeletal" },
    "ui": { "space": "screen" },
    "audio": { "spatial": true },
    "visualMappings": "presentation/mappings/arcengine-sample-isometric3d.json"
}
