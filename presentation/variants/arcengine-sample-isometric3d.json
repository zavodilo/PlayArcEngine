{
    "id": "arcengine-sample-isometric3d",
    "name": "ArcEngine Sample — Isometric 3D",
    "profile": "isometric3d",
    "enabled": true,
    "description": "Diablo-like presentation: a fixed orthographic camera over real 3D geometry, models instead of sprites, stylized 3D lighting with crisp shadows.",
