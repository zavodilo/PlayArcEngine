{
    "id": "arcengine-sample-lowpoly3d",
    "name": "ArcEngine Sample — Stylized 3D",
    "profile": "lowpoly3d",
    "enabled": true,
    "description": "The kit's default look: perspective camera, toon bands, ink edges and silhouette outline, exactly as Constants.js authors it. This is project.json's defaultVariant.",
