    "camera": {
        "mode": "orbit",
        "follow": null,
        "azimuthDeg": -90,
        "elevationDeg": 57,
        "orbit": true
    },
    "lighting": {
        "preset": "isometric",
        "toon": 1,
        "ink": 2,
        "outline": 2,
        "shadows": 1
    },
    "materials": { "shading": "toon" },
    "environment": { "ground": "low-poly-terrain", "flatten": 0 },
    "animation": { "style": "skeletal" },
    "ui": { "space": "screen" },
    "audio": { "spatial": true },
    "visualMappings": "presentation/mappings/arcengine-sample-lowpoly3d.json"
}
