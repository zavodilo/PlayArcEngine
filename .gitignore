# Do not upload to GitHub: personal stuff and what gets built by itself. A leading "/" — root only
# (without it build/ would also hide claude/skills/build/).
# .claude holds local settings; its skills/ subtree is GENERATED by tools/sync-skills.mjs
# and IS committed (agents discover it natively).
/.claude/*
!/.claude/skills/
/upload.bat
/_utils/.backups/
/build/
/dist/

# Dev-only tooling of the verification gates (never part of the kit): puppeteer lives in
# node_modules only for `node tools/check.mjs --all` / tools/headless-gate.mjs, and verify/
# holds their screenshots and JSON reports.
/node_modules/
/verify/
